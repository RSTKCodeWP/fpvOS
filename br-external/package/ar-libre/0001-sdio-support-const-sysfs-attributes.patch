From: fpvOS contributors <dev@fpvos.local>
Subject: [PATCH] sdio: support const sysfs attributes on Linux 6.16+

Keep compatibility with the older kernels used by the other boards.

Upstream: not submitted
Signed-off-by: fpvOS contributors <dev@fpvos.local>

diff --git a/driver/sdio.c b/driver/sdio.c
index 8d9a7fa..369db40 100644
--- a/driver/sdio.c
+++ b/driver/sdio.c
@@ -18,6 +18,7 @@
  *     A frame split in two transfers is dropped.
  */
 #include <linux/module.h>
+#include <linux/version.h>
 #include <linux/mmc/card.h>
 #include <linux/mmc/host.h>
 #include <linux/mmc/sdio.h>
@@ -102,7 +103,12 @@ static void trace(u16 type, u16 a, u32 b)
 }
 
 /* The ring, oldest first: a u32 count, then the records. */
-static ssize_t trace_read(struct file *f, struct kobject *k, struct bin_attribute *attr,
+static ssize_t trace_read(struct file *f, struct kobject *k,
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 16, 0)
+                          const struct bin_attribute *attr,
+#else
+                          struct bin_attribute *attr,
+#endif
 			  char *buf, loff_t off, size_t count)
 {
 	size_t total = sizeof(u32) + TRACE_N * sizeof(struct trace_rec);
