config BR2_PACKAGE_AR9311_RECOVERY
	bool "AR9311 built-in NAND recovery environment"
	depends on BR2_aarch64 && BR2_STATIC_LIBS
	depends on BR2_PACKAGE_FPVOS_UPDATE_AR9311
	select BR2_PACKAGE_DROPBEAR
	help
	  Build a small independent initramfs into the NAND kernel. It loads
	  and verifies the main fpvOS RAM root from NAND, or provides the USB
	  updater and SSH recovery service without an SD card.
