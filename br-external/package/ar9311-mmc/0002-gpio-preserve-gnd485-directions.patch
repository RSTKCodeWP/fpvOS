From: fpvOS contributors <dev@fpvos.local>
Subject: [PATCH] gpio: preserve Gnd485 boot-time direction state

Gnd485 direction readback is valid, unlike the legacy assumption.
Seed from hardware so the first GPIO request preserves other outputs
in the same bank. Retain the existing behavior on other boards.

Upstream: not submitted
Signed-off-by: fpvOS contributors <dev@fpvos.local>

--- a/modules/artosyn_gpio.c
+++ b/modules/artosyn_gpio.c
@@ -38,6 +38,7 @@
 	struct gpio_chip	gc;
 	void __iomem		*regs;		/* base + 0xBC + N*0xC */
 	spinlock_t		lock;
+	bool			dir_readable;
 	u32			dir_shadow;	/* DIRIN is unreadable; mirror it */
 	u32			out_shadow;	/* SET readback mixes in input-pin
 						 * state, so a read-modify-write
@@ -108,8 +109,11 @@
 {
 	struct ar_gpio_bank *b = gpiochip_get_data(gc);
 
-	/* DIRIN is write-only here; report from the shadow (1 = input). */
-	return (b->dir_shadow & BIT(off)) ?
+	/* Gnd485 has working readback; other boards retain shadow semantics. */
+	u32 dir = b->dir_readable ? readl(b->regs + AR_REG_DIRIN) :
+				   READ_ONCE(b->dir_shadow);
+
+	return (dir & BIT(off)) ?
 		GPIO_LINE_DIRECTION_IN : GPIO_LINE_DIRECTION_OUT;
 }
 
@@ -149,8 +153,16 @@
 
 		b->regs = base + AR_BANK_REG_BASE + i * AR_BANK_STRIDE;
 		spin_lock_init(&b->lock);
-		/* DIRIN is unreadable; seed the shadow as all-input (safe default). */
-		b->dir_shadow = 0xffffffff;
+		/*
+		 * Gnd485 readback matches the actual direction bits. Preserve
+		 * firmware outputs before the first hog/regulator changes a
+		 * direction in this bank. Seed without writing the registers.
+		 * Retain the legacy fallback for boards without this readback.
+		 */
+		b->dir_readable = of_device_is_compatible(pdev->dev.of_node,
+							  "caddx,gnd485-gpio");
+		b->dir_shadow = b->dir_readable ?
+			readl(b->regs + AR_REG_DIRIN) : 0xffffffff;
 		/* Seed the output shadow from the current latch so the first write
 		 * preserves pins the bootloader/regulators already drive.
 		 */
@@ -181,6 +193,7 @@
 }
 
 static const struct of_device_id ar_gpio_match[] = {
+	{ .compatible = "caddx,gnd485-gpio" },
 	{ .compatible = "artosyn,gpio" },
 	{}
 };
