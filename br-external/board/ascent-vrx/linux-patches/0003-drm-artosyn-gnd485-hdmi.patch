From: fpvOS developers
Subject: [PATCH] drm: add fixed-mode Gnd485 VO, DSI and HDMI support

Adapt the Artosyn VO and DSI integration from Missing-Lynk/ml-kernel
 e3885c6394a7025eacd3a23f473276d9823beb25, retaining GPL-2.0 licensing.
Use the Gnd485 stock DC raster, clock divider and D-PHY timing table;
restrict scanout to the validated 1080p60 RGB primary plane. Expose real
vblank/page-flip events with contiguous DMA buffers.

The revision-e2 bridge needs fixed-M calibration followed by PCR release
and another PCR reset after TMDS enable. Keep these quirks
board-qualified, permit IRQ-less connector polling, and retain ordinary
LT9611 behavior for other boards. Fixed-mode HDMI only: DVI, audio and EDID
negotiation are not validated. GPIO/pinmux and early power still depend on
the vendor boot chain. No proprietary display code or data is included.

---

--- a/drivers/gpu/drm/Kconfig
+++ b/drivers/gpu/drm/Kconfig
@@ -429,3 +429,5 @@
 # Separate option because drm_panel_orientation_quirks.c is shared with fbdev
 config DRM_PANEL_ORIENTATION_QUIRKS
 	tristate
+
+source "drivers/gpu/drm/artosyn/Kconfig"
--- a/drivers/gpu/drm/Makefile
+++ b/drivers/gpu/drm/Makefile
@@ -253,3 +253,5 @@
 
 $(obj)/%.hdrtest: $(src)/%.h FORCE
 	$(call if_changed_dep,hdrtest)
+
+obj-$(CONFIG_DRM_ARTOSYN) += artosyn/
--- a/drivers/gpu/drm/bridge/lontium-lt9611.c
+++ b/drivers/gpu/drm/bridge/lontium-lt9611.c
@@ -47,6 +47,7 @@
 	struct mipi_dsi_device *dsi1;
 
 	bool ac_mode;
+	bool gnd485;
 
 	struct gpio_desc *reset_gpio;
 	struct gpio_desc *enable_gpio;
@@ -640,6 +641,63 @@
 	return 0;
 }
 
+/*
+ * Gnd485 revision-e2: calibrate at fixed M, then release pixel-clock recovery.
+ * Reset PCR once more AFTER enabling TMDS; doing this only before output-enable
+ * leaves the first cold modeset black. Never select the internal test pattern.
+ * This board currently supports only RGB 1080p60 over HDMI (no DVI/audio).
+ */
+static int lt9611_gnd485_enable(struct lt9611 *lt)
+{
+	unsigned int lock, cal, band;
+	int ret;
+	static const struct reg_sequence init[] = {
+		{ 0x8130, 0x6a }, { 0x824f, 0x80 }, { 0x8250, 0x10 },
+		/* Fixed RGB 16:9 VIC 16 AVI packet, also used without EDID. */
+		{ 0x82d6, 0x8e }, { 0x82d7, 4 },
+		{ 0x8443, 0x27 }, { 0x8444, 0x10 }, { 0x8445, 0x28 },
+		{ 0x8446, 0 }, { 0x8447, 16 }, { 0x843d, 8 },
+		{ 0x8123, 0x40 }, { 0x8124, 0x62 }, { 0x8125, 0x80 },
+		{ 0x832d, 0x40 }, { 0x8331, 8 }, { 0x8326, 0xb6 },
+		{ 0x82de, 0x20 }, { 0x82de, 0xe0 },
+		{ 0x8011, 0x5a }, { 0x8011, 0xfa }, { 0x8016, 0xf2 },
+		{ 0x8018, 0xdc }, { 0x8018, 0xfc }, { 0x8016, 0xf3 },
+		{ 0x8140, 0x98 }, { 0x8141, 0x98 },
+		{ 0x8142, 0x98 }, { 0x8143, 0x98 },
+	};
+
+	static const struct reg_sequence calibrate[] = {
+		{ 0x8016, 0xe3 }, { 0x8016, 0xf3, 100000 },
+	};
+	static const struct reg_sequence enable[] = {
+		{ 0x8326, 0x36 }, { 0x8011, 0x5a, 10000 },
+		{ 0x8011, 0xfa, 100000 },
+		{ 0x8130, 0xea, 100000 },
+		{ 0x8326, 0x36 }, { 0x8011, 0x5a, 10000 }, { 0x8011, 0xfa },
+	};
+
+	ret = regmap_multi_reg_write(lt->regmap, init, ARRAY_SIZE(init));
+	if (ret)
+		return ret;
+	msleep(100);
+	ret = regmap_multi_reg_write(lt->regmap, calibrate, ARRAY_SIZE(calibrate));
+	if (ret)
+		return ret;
+	ret = regmap_read(lt->regmap, 0x8215, &lock);
+	if (ret)
+		return ret;
+	ret = regmap_read(lt->regmap, 0x82e7, &cal);
+	if (ret)
+		return ret;
+	ret = regmap_read(lt->regmap, 0x82e6, &band);
+	if (ret)
+		return ret;
+	if (!(lock & 0x80) || !(cal & 0x80) || band == 0xff)
+		return -ETIMEDOUT;
+
+	return regmap_multi_reg_write(lt->regmap, enable, ARRAY_SIZE(enable));
+}
+
 /* bridge funcs */
 static void lt9611_bridge_atomic_enable(struct drm_bridge *bridge,
 					struct drm_atomic_state *state)
@@ -684,8 +742,16 @@
 
 	lt9611_video_check(lt9611);
 
-	/* Enable HDMI output */
-	regmap_write(lt9611->regmap, 0x8130, 0xea);
+	if (lt9611->gnd485) {
+		int ret = lt9611_gnd485_enable(lt9611);
+
+		if (ret) {
+			regmap_write(lt9611->regmap, 0x8130, 0x6a);
+			dev_err(lt9611->dev, "Gnd485 HDMI initialization failed: %d\n", ret);
+		}
+	} else {
+		regmap_write(lt9611->regmap, 0x8130, 0xea);
+	}
 }
 
 static void lt9611_bridge_atomic_disable(struct drm_bridge *bridge,
@@ -728,8 +794,9 @@
 
 	dsi->lanes = 4;
 	dsi->format = MIPI_DSI_FMT_RGB888;
-	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
-			  MIPI_DSI_MODE_VIDEO_HSE;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_HSE;
+	if (!lt9611->gnd485)
+		dsi->mode_flags |= MIPI_DSI_MODE_VIDEO_SYNC_PULSE;
 
 	ret = devm_mipi_dsi_attach(dev, dsi);
 	if (ret < 0) {
@@ -1079,6 +1146,7 @@
 		return PTR_ERR(lt9611);
 
 	lt9611->dev = dev;
+	lt9611->gnd485 = of_device_is_compatible(dev->of_node, "artosyn,gnd485-lt9611");
 	lt9611->client = client;
 	lt9611->sleep = false;
 
@@ -1116,12 +1184,14 @@
 		goto err_disable_regulators;
 	}
 
-	ret = devm_request_threaded_irq(dev, client->irq, NULL,
-					lt9611_irq_thread_handler,
-					IRQF_ONESHOT, "lt9611", lt9611);
-	if (ret) {
-		dev_err(dev, "failed to request irq\n");
-		goto err_disable_regulators;
+	if (client->irq > 0) {
+		ret = devm_request_threaded_irq(dev, client->irq, NULL,
+					      lt9611_irq_thread_handler,
+					      IRQF_ONESHOT, "lt9611", lt9611);
+		if (ret) {
+			dev_err(dev, "failed to request irq\n");
+			goto err_disable_regulators;
+		}
 	}
 
 	i2c_set_clientdata(client, lt9611);
@@ -1131,8 +1201,10 @@
 
 	lt9611->bridge.of_node = client->dev.of_node;
 	lt9611->bridge.ops = DRM_BRIDGE_OP_DETECT | DRM_BRIDGE_OP_EDID |
-			     DRM_BRIDGE_OP_HPD | DRM_BRIDGE_OP_MODES |
+			     DRM_BRIDGE_OP_MODES |
 			     DRM_BRIDGE_OP_HDMI | DRM_BRIDGE_OP_HDMI_AUDIO;
+	if (client->irq > 0)
+		lt9611->bridge.ops |= DRM_BRIDGE_OP_HPD;
 	lt9611->bridge.type = DRM_MODE_CONNECTOR_HDMIA;
 	lt9611->bridge.vendor = "Lontium";
 	lt9611->bridge.product = "LT9611";
@@ -1158,7 +1230,8 @@
 		}
 	}
 
-	lt9611_enable_hpd_interrupts(lt9611);
+	if (client->irq > 0)
+		lt9611_enable_hpd_interrupts(lt9611);
 
 	return 0;
 
@@ -1179,7 +1252,8 @@
 {
 	struct lt9611 *lt9611 = i2c_get_clientdata(client);
 
-	disable_irq(client->irq);
+	if (client->irq > 0)
+		disable_irq(client->irq);
 	drm_bridge_remove(&lt9611->bridge);
 
 	regulator_bulk_disable(ARRAY_SIZE(lt9611->supplies), lt9611->supplies);
--- /dev/null
+++ b/drivers/gpu/drm/artosyn/Kconfig
@@ -0,0 +1,13 @@
+config DRM_ARTOSYN
+	bool "Artosyn Gnd485 HDMI display"
+	depends on DRM=y && OF && ARM64
+	select DRM_KMS_HELPER
+	select DRM_GEM_DMA_HELPER
+	select DRM_MIPI_DSI
+	select DRM_DW_MIPI_DSI
+	select DRM_DISPLAY_HELPER
+	select DRM_BRIDGE_CONNECTOR
+	help
+	  Fixed 1920x1080p60 RGB scanout for the Ascent Gnd485 receiver.
+	  Includes the VO controller and Artosyn DSI PHY glue. Requires
+	  the board-specific Lontium bridge configuration in its DT.
--- /dev/null
+++ b/drivers/gpu/drm/artosyn/Makefile
@@ -0,0 +1 @@
+obj-$(CONFIG_DRM_ARTOSYN) += artosyn_vo.o artosyn_dsi.o
--- /dev/null
+++ b/drivers/gpu/drm/artosyn/artosyn_vo.c
@@ -0,0 +1,414 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Artosyn Gnd485 VO: one RGB primary plane, fixed 1920x1080 at nominal 60 Hz.
+ * Adapted from Missing-Lynk/ml-kernel e3885c6394a7025eacd3a23f473276d9823beb25.
+ * Register sequencing originates in that project's Artosyn display work;
+ * HDMI clock/timing integration is specific to the Ascent Gnd485 receiver.
+ * The DC feeds the Artosyn DSI host and Lontium HDMI bridge.
+ */
+
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/interrupt.h>
+
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_bridge.h>
+#include <drm/drm_bridge_connector.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+#include <drm/drm_vblank.h>
+
+#define VO_GLOBAL	0x0000
+#define  VO_GLOBAL_AXI_EN	BIT(11)
+#define  VO_GLOBAL_SRESET	BIT(12)
+#define VO_FB_BASE0	0x1400
+#define VO_FB_STRIDE	0x1408
+#define VO_PANEL_CTRL	0x1418
+#define VO_H_ACT_FP	0x1430
+#define VO_H_SA_BP	0x1438
+#define VO_V_ACT_FP	0x1440
+#define VO_V_SA_BP	0x1448
+#define VO_INT_STATUS	0x147c
+#define VO_INT_ENABLE	0x1480
+#define  VO_INT_VSYNC		BIT(0)
+#define VO_DPI_FORMAT	0x14b8
+#define VO_MAIN_CTRL	0x1518
+#define  VO_MAIN_LOCK		BIT(3)
+#define  VO_MAIN_START		BIT(4)
+#define VO_FB_FORMAT	0x1520
+#define VO_PLANE2_BASE	0x1530
+#define VO_PLANE3_BASE	0x1538
+#define VO_FB_SIZE	0x1810
+#define VO_FIFO_THRESH0	0x1800
+#define VO_FIFO_THRESH1	0x1808
+#define VO_WIN_X	0x1828
+#define VO_WIN_Y	0x1830
+#define VO_LAYER_ALPHA	0x1a18
+#define VO_SCALER_RATIO	0x1a20
+#define VO_QOS		0xff00
+#define VO_DPI_CTRL	0x1f40
+
+#define VO_CURSOR_CFG	0x1468
+
+#define VO_SYNC_VALID	0x40000000
+
+struct ar_vo {
+	struct drm_device		drm;
+	struct drm_simple_display_pipe	pipe;
+
+	void __iomem			*regs;
+	void __iomem			*crg;
+	void __iomem			*pixreg;
+	u32				cur_cfg;
+};
+
+#define to_ar_vo(d) container_of(d, struct ar_vo, drm)
+
+static const u32 ar_vo_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888, /* Alpha is ignored on the opaque primary. */
+};
+
+/* Keep a clean configuration word: readback includes hardware status bits.
+ * Shadow framebuffer addresses latch when config-lock (bit 3) is cleared.
+ */
+static void ar_vo_set_fb_addr(struct ar_vo *vo, struct drm_plane_state *state)
+{
+	u32 addr = lower_32_bits(drm_fb_dma_get_gem_addr(state->fb, state, 0));
+
+	writel(vo->cur_cfg | VO_MAIN_LOCK, vo->regs + VO_MAIN_CTRL);
+	writel(state->fb->pitches[0], vo->regs + VO_FB_STRIDE);
+	writel(addr, vo->regs + VO_FB_BASE0);
+	writel(addr, vo->regs + VO_PLANE2_BASE);
+	writel(addr, vo->regs + VO_PLANE3_BASE);
+	writel(vo->cur_cfg, vo->regs + VO_MAIN_CTRL);
+}
+
+#define VO_1080P60_SCALE_CFG 0
+#define VO_1080P60_DPI_FORMAT 5
+#define VO_1080P60_PANEL_CTRL 0x111
+#define VO_1080P60_DPI_CTRL 0x00120000
+
+static void ar_vo_pipe_enable(struct drm_simple_display_pipe *pipe,
+			      struct drm_crtc_state *crtc_state,
+			      struct drm_plane_state *plane_state)
+{
+	struct ar_vo *vo = to_ar_vo(pipe->crtc.dev);
+	const struct drm_display_mode *mode = &crtc_state->adjusted_mode;
+	u32 g;
+
+	/* MIPI_TX_PLL / 2 / 3 feeds the internal DC raster. */
+	writel((readl(vo->pixreg) & ~GENMASK(10, 0)) | BIT(12) | 0x702,
+	       vo->pixreg);
+
+	/* Enable DC fetch clocks, release reset, pulse bits 9/10. */
+	writel(readl(vo->crg) | BIT(0),  vo->crg);
+	writel(readl(vo->crg) | BIT(1),  vo->crg);
+	writel(readl(vo->crg) & ~BIT(2), vo->crg);
+	writel(readl(vo->crg) | BIT(12), vo->crg);
+	writel(readl(vo->crg) & ~0x600,  vo->crg);
+	writel(readl(vo->crg) | 0x600,   vo->crg);
+
+	writel(readl(vo->regs + VO_CURSOR_CFG) & ~0x3, vo->regs + VO_CURSOR_CFG);
+
+	/* Core reset, then clear the active-low AXI gate without clobbering defaults. */
+	g = readl(vo->regs + VO_GLOBAL);
+	writel(g | VO_GLOBAL_SRESET, vo->regs + VO_GLOBAL);
+	writel(g, vo->regs + VO_GLOBAL);
+	udelay(5);
+	writel(0, vo->regs + VO_MAIN_CTRL);
+	writel(readl(vo->regs + VO_GLOBAL) & ~VO_GLOBAL_AXI_EN, vo->regs + VO_GLOBAL);
+
+	/* Internal raster is 2293 x 1125 at ~154.8 MHz. The DSI/PCR
+	 * path converts this to the fixed HDMI mode; measured vblank ~60.009 Hz.
+	 */
+	writel(0x08f50780, vo->regs + VO_H_ACT_FP);
+	writel(0x441807f5, vo->regs + VO_H_SA_BP);
+	writel((mode->vtotal << 16) | mode->vdisplay, vo->regs + VO_V_ACT_FP);
+	writel(VO_SYNC_VALID | (mode->vsync_end << 15) | mode->vsync_start, vo->regs + VO_V_SA_BP);
+
+	writel((mode->vdisplay << 15) | mode->hdisplay, vo->regs + VO_FB_SIZE);
+	writel(0, vo->regs + VO_WIN_X);
+	writel(0, vo->regs + VO_WIN_Y);
+	writel(0x3c0, vo->regs + VO_FIFO_THRESH0);
+	writel(0x3c0, vo->regs + VO_FIFO_THRESH1);
+	writel(0xff000000, vo->regs + VO_LAYER_ALPHA);
+	writel(0x80008000, vo->regs + VO_SCALER_RATIO);
+
+	writel(VO_1080P60_SCALE_CFG, vo->regs + VO_FB_FORMAT);
+	writel(VO_1080P60_DPI_FORMAT, vo->regs + VO_DPI_FORMAT);
+	writel(VO_1080P60_PANEL_CTRL, vo->regs + VO_PANEL_CTRL);
+	writel(VO_1080P60_DPI_CTRL, vo->regs + VO_DPI_CTRL);
+	writel(0xff, vo->regs + VO_QOS);
+
+	vo->cur_cfg = (5 << 26) | BIT(0); /* opaque XRGB8888, not yet started */
+	writel(vo->cur_cfg, vo->regs + VO_MAIN_CTRL);
+	ar_vo_set_fb_addr(vo, plane_state);
+	vo->cur_cfg |= VO_MAIN_START;
+	writel(vo->cur_cfg, vo->regs + VO_MAIN_CTRL);
+
+	drm_crtc_vblank_on(&pipe->crtc);
+}
+
+static void ar_vo_pipe_disable(struct drm_simple_display_pipe *pipe)
+{
+	struct ar_vo *vo = to_ar_vo(pipe->crtc.dev);
+
+	drm_crtc_vblank_off(&pipe->crtc);
+	writel(0, vo->regs + VO_MAIN_CTRL);
+
+	vo->cur_cfg &= ~VO_MAIN_START;
+}
+
+static void ar_vo_pipe_update(struct drm_simple_display_pipe *pipe,
+			      struct drm_plane_state *old_state)
+{
+	struct ar_vo *vo = to_ar_vo(pipe->crtc.dev);
+	struct drm_plane_state *state = pipe->plane.state;
+	struct drm_crtc *crtc = &pipe->crtc;
+
+	if (state->fb)
+		ar_vo_set_fb_addr(vo, state);
+
+	if (crtc->state->event) {
+		spin_lock_irq(&crtc->dev->event_lock);
+		if (drm_crtc_vblank_get(crtc) == 0)
+			drm_crtc_arm_vblank_event(crtc, crtc->state->event);
+		else
+			drm_crtc_send_vblank_event(crtc, crtc->state->event);
+
+		crtc->state->event = NULL;
+		spin_unlock_irq(&crtc->dev->event_lock);
+	}
+}
+
+static int ar_vo_enable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct ar_vo *vo = to_ar_vo(pipe->crtc.dev);
+
+	writel(readl(vo->regs + VO_INT_ENABLE) | VO_INT_VSYNC, vo->regs + VO_INT_ENABLE);
+	return 0;
+}
+
+static void ar_vo_disable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	struct ar_vo *vo = to_ar_vo(pipe->crtc.dev);
+
+	writel(readl(vo->regs + VO_INT_ENABLE) & ~VO_INT_VSYNC, vo->regs + VO_INT_ENABLE);
+}
+
+static enum drm_mode_status ar_vo_mode_valid(struct drm_simple_display_pipe *pipe,
+					  const struct drm_display_mode *m)
+{
+	if (m->clock != 148500 || m->hdisplay != 1920 || m->vdisplay != 1080 ||
+	    m->hsync_start != 2008 || m->hsync_end != 2052 || m->htotal != 2200 ||
+	    m->vsync_start != 1084 || m->vsync_end != 1089 || m->vtotal != 1125 ||
+	    (m->flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN |
+			 DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC)))
+		return MODE_BAD;
+	return MODE_OK;
+}
+
+/* Only the aligned linear RGB layout has been validated on this board. */
+static int ar_vo_pipe_check(struct drm_simple_display_pipe *pipe,
+			    struct drm_plane_state *state,
+			    struct drm_crtc_state *crtc_state)
+{
+	struct drm_framebuffer *fb = state->fb;
+
+	if (fb && (fb->pitches[0] != 8192 || fb->offsets[0] ||
+		   state->src_x || state->src_y))
+		return -EINVAL;
+	return 0;
+}
+
+static const struct drm_simple_display_pipe_funcs ar_vo_pipe_funcs = {
+	.mode_valid	= ar_vo_mode_valid,
+	.check		= ar_vo_pipe_check,
+	.enable		= ar_vo_pipe_enable,
+	.disable	= ar_vo_pipe_disable,
+	.update		= ar_vo_pipe_update,
+	.enable_vblank	= ar_vo_enable_vblank,
+	.disable_vblank	= ar_vo_disable_vblank,
+};
+
+static irqreturn_t ar_vo_irq(int irq, void *data)
+{
+	struct ar_vo *vo = data;
+	u32 status = readl(vo->regs + VO_INT_STATUS);
+
+	if (!(status & VO_INT_VSYNC))
+		return IRQ_NONE;
+
+	/* Write back to acknowledge the frame-start interrupt. */
+	writel(status, vo->regs + VO_INT_STATUS);
+	drm_crtc_handle_vblank(&vo->pipe.crtc);
+
+	return IRQ_HANDLED;
+}
+
+DEFINE_DRM_GEM_DMA_FOPS(ar_vo_fops);
+
+static int ar_vo_dumb_create(struct drm_file *file, struct drm_device *dev,
+			     struct drm_mode_create_dumb *args)
+{
+	if (args->bpp != 32 || args->width > 1920 || args->height > 1080)
+		return -EINVAL;
+	args->pitch = ALIGN(args->width, 512) * 4;
+
+	return drm_gem_dma_dumb_create_internal(file, dev, args);
+}
+
+static const struct drm_driver ar_vo_drm_driver = {
+	.driver_features	= DRIVER_GEM | DRIVER_MODESET | DRIVER_ATOMIC,
+	.fops			= &ar_vo_fops,
+	DRM_GEM_DMA_DRIVER_OPS_WITH_DUMB_CREATE(ar_vo_dumb_create),
+	.name			= "artosyn-vo",
+	.desc			= "Artosyn VO display controller",
+	.major			= 1,
+	.minor			= 0,
+};
+
+static const struct drm_mode_config_funcs ar_vo_mode_config_funcs = {
+	.fb_create	= drm_gem_fb_create,
+	.atomic_check	= drm_atomic_helper_check,
+	.atomic_commit	= drm_atomic_helper_commit,
+};
+
+static int ar_vo_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct drm_bridge *bridge;
+	struct resource *r;
+	struct ar_vo *vo;
+	int ret, irq;
+	struct drm_connector *connector;
+
+	vo = devm_drm_dev_alloc(dev, &ar_vo_drm_driver, struct ar_vo, drm);
+	if (IS_ERR(vo))
+		return PTR_ERR(vo);
+
+	platform_set_drvdata(pdev, vo);
+
+	vo->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(vo->regs))
+		return PTR_ERR(vo->regs);
+
+	/* Shared with the codec media-CRG mapping; only touch the DC word. */
+	r = platform_get_resource(pdev, IORESOURCE_MEM, 2);
+	if (!r || resource_size(r) != 4)
+		return -EINVAL;
+	vo->crg = devm_ioremap(dev, r->start, resource_size(r));
+	if (!vo->crg)
+		return -ENOMEM;
+
+	vo->pixreg = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(vo->pixreg))
+		return PTR_ERR(vo->pixreg);
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	ret = dma_coerce_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	bridge = devm_drm_of_get_bridge(dev, dev->of_node, 0, 0);
+	if (IS_ERR(bridge))
+		return dev_err_probe(dev, PTR_ERR(bridge), "no DSI bridge\n");
+
+	ret = drmm_mode_config_init(&vo->drm);
+	if (ret)
+		return ret;
+
+	vo->drm.mode_config.min_width = 0;
+	vo->drm.mode_config.min_height = 0;
+	vo->drm.mode_config.max_width = 1920;
+	vo->drm.mode_config.max_height = 1080;
+	vo->drm.mode_config.funcs = &ar_vo_mode_config_funcs;
+
+	ret = drm_vblank_init(&vo->drm, 1);
+	if (ret)
+		return ret;
+
+	ret = drm_simple_display_pipe_init(&vo->drm, &vo->pipe, &ar_vo_pipe_funcs,
+					   ar_vo_formats, ARRAY_SIZE(ar_vo_formats),
+					   NULL, NULL);
+	if (ret)
+		return ret;
+
+	ret = drm_bridge_attach(&vo->pipe.encoder, bridge, NULL, DRM_BRIDGE_ATTACH_NO_CONNECTOR);
+	if (ret)
+		return ret;
+
+	connector = drm_bridge_connector_init(&vo->drm, &vo->pipe.encoder);
+	if (IS_ERR(connector))
+		return PTR_ERR(connector);
+	ret = drm_connector_attach_encoder(connector, &vo->pipe.encoder);
+	if (ret)
+		return ret;
+
+	drm_mode_config_reset(&vo->drm);
+
+	ret = devm_request_irq(dev, irq, ar_vo_irq, 0, "artosyn-vo", vo);
+	if (ret)
+		return ret;
+
+	ret = drm_dev_register(&vo->drm, 0);
+	if (ret)
+		return ret;
+
+	drm_kms_helper_poll_init(&vo->drm);
+
+	return 0;
+}
+
+static void ar_vo_remove(struct platform_device *pdev)
+{
+	struct ar_vo *vo = platform_get_drvdata(pdev);
+
+	drm_kms_helper_poll_fini(&vo->drm);
+	drm_dev_unregister(&vo->drm);
+	drm_atomic_helper_shutdown(&vo->drm);
+}
+
+static void ar_vo_shutdown(struct platform_device *pdev)
+{
+	struct ar_vo *vo = platform_get_drvdata(pdev);
+
+	drm_atomic_helper_shutdown(&vo->drm);
+}
+
+static const struct of_device_id ar_vo_match[] = {
+	{ .compatible = "artosyn,gnd485-vo" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, ar_vo_match);
+
+static struct platform_driver ar_vo_driver = {
+	.probe	= ar_vo_probe,
+	.remove	= ar_vo_remove,
+	.shutdown = ar_vo_shutdown,
+	.driver = {
+		.name		= "artosyn-vo",
+		.of_match_table	= ar_vo_match,
+
+	},
+};
+module_platform_driver(ar_vo_driver);
+
+MODULE_DESCRIPTION("Artosyn VO display controller (DRM/KMS)");
+MODULE_LICENSE("GPL");
--- /dev/null
+++ b/drivers/gpu/drm/artosyn/artosyn_dsi.c
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Gnd485 glue for the Synopsys DSI host and Artosyn custom D-PHY.
+ * Adapted from Missing-Lynk/ml-kernel e3885c6394a7025eacd3a23f473276d9823beb25.
+ * The Gnd485-specific register table is taken from the working vendor mode.
+ * Only four lanes, RGB888 and 1920x1080p60 sync-event video are supported.
+ * D-PHY timing and PLL are fixed (~928.8 Mbps/lane); generic non-burst host
+ * horizontal timings need overriding to match this board's internal raster.
+ */
+
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include <drm/bridge/dw_mipi_dsi.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+
+#define DSI_PHY_RSTZ		0xa0
+#define DSI_PHY_IF_CFG		0xa4
+
+struct ar_dsi {
+	struct device		*dev;
+	void __iomem		*base;
+	struct clk		*pclk;
+	struct dw_mipi_dsi	*dmd;
+	struct dw_mipi_dsi_plat_data pdata;
+	unsigned int		lanes;
+};
+
+static const struct { u16 off; u32 val; } ar_dphy_1080p60[] = {
+	{ 0x2c4, 0x0410b016 }, { 0x2c8, 0x002468ac }, { 0x2cc, 0x0000000a },
+	{ 0x2d0, 0x00003675 }, { 0x2d4, 0x00000064 }, { 0x2d8, 0x21080c00 },
+	{ 0x2dc, 0x120d210a }, { 0x2e0, 0x000a0000 }, { 0x2e4, 0x00000012 },
+	{ 0x2e8, 0x0000206a }, { 0x2ec, 0x000000c4 }, { 0x2f0, 0x00c803e8 },
+	{ 0x2f4, 0x10080c00 }, { 0x2f8, 0x0000120d }, { 0x2fc, 0x00421236 },
+	{ 0x300, 0x000a0000 }, { 0x304, 0x00000012 }, { 0x308, 0x0000206a },
+	{ 0x30c, 0x000000c4 }, { 0x310, 0x10080c00 }, { 0x314, 0x0000120d },
+	{ 0x318, 0x00000008 }, { 0x32c, 0x0000000a }, { 0x330, 0x00003675 },
+	{ 0x334, 0x00000064 }, { 0x338, 0x21080c00 }, { 0x33c, 0x120d210a },
+	{ 0x340, 0x000a0000 }, { 0x344, 0x00000012 }, { 0x348, 0x0000206a },
+	{ 0x34c, 0x000000c4 }, { 0x350, 0x00c803e8 }, { 0x354, 0x10080c00 },
+	{ 0x358, 0x0000120d }, { 0x35c, 0x00421236 }, { 0x360, 0x000a0000 },
+	{ 0x364, 0x00000012 }, { 0x368, 0x0000206a }, { 0x36c, 0x000000c4 },
+	{ 0x370, 0x10080c00 }, { 0x374, 0x0000120d }, { 0x378, 0x00000008 },
+	{ 0x38c, 0x00011400 }, { 0x394, 0x00000200 }, { 0x398, 0x00008000 },
+	{ 0x3a0, 0x00000200 }, { 0x3a4, 0x00008000 },
+};
+
+static const struct { u16 off; u32 val; } ar_dsi_vid_1080p60[] = {
+	{ 0x08, 0x812 },
+	{ 0x48, 44 },
+	{ 0x4c, 148 },
+	{ 0x50, 1720 },
+	{ 0x68, 0x010f7f00 },
+
+	{ 0x18, 0x00000000 },
+	{ 0x2c, 0x00000004 },
+
+	{ 0x80, 0x00000020 },
+	{ 0x88, 0x00000020 },
+	{ 0x8c, 0x00000020 },
+	{ 0x94, 0x00000001 },
+	{ 0x98, 0x00000000 },
+	{ 0x9c, 0x00000000 },
+	{ 0xb4, 0x00000001 },
+};
+
+#define AR_DSI_MIPI_PLL_DIV	0x044e7f72
+
+static int ar_dsi_phy_init(void *priv)
+{
+	struct ar_dsi *dsi = priv;
+	unsigned int i;
+
+	writel(AR_DSI_MIPI_PLL_DIV, dsi->base + 0x2c0);
+
+	for (i = 0; i < ARRAY_SIZE(ar_dphy_1080p60); i++)
+		writel(ar_dphy_1080p60[i].val, dsi->base + ar_dphy_1080p60[i].off);
+
+	/* Called after dw-mipi-dsi programs the standard host registers. */
+	for (i = 0; i < ARRAY_SIZE(ar_dsi_vid_1080p60); i++)
+		writel(ar_dsi_vid_1080p60[i].val, dsi->base + ar_dsi_vid_1080p60[i].off);
+
+	writel(dsi->lanes - 1, dsi->base + DSI_PHY_IF_CFG);
+	writel(0xd, dsi->base + DSI_PHY_RSTZ);
+	writel(0xf, dsi->base + DSI_PHY_RSTZ);
+
+	return 0;
+}
+
+static int ar_dsi_get_lane_mbps(void *priv, const struct drm_display_mode *mode,
+				unsigned long mode_flags, u32 lanes, u32 format,
+				unsigned int *lane_mbps)
+{
+	if (lanes != 4 || format != MIPI_DSI_FMT_RGB888 ||
+	    mode->clock != 148500 || mode->hdisplay != 1920 || mode->vdisplay != 1080)
+		return -EINVAL;
+	*lane_mbps = 929;
+	return 0;
+}
+
+static int ar_dsi_get_timing(void *priv, unsigned int lane_mbps,
+			     struct dw_mipi_dsi_dphy_timing *timing)
+{
+	timing->clk_lp2hs = 0x40;
+	timing->clk_hs2lp = 0x40;
+	timing->data_lp2hs = 0x40;
+	timing->data_hs2lp = 0x40;
+
+	return 0;
+}
+
+static const struct dw_mipi_dsi_phy_ops ar_dsi_phy_ops = {
+	.init		= ar_dsi_phy_init,
+	.get_lane_mbps	= ar_dsi_get_lane_mbps,
+	.get_timing	= ar_dsi_get_timing,
+};
+
+static int ar_dsi_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	struct ar_dsi *dsi;
+
+	dsi = devm_kzalloc(dev, sizeof(*dsi), GFP_KERNEL);
+	if (!dsi)
+		return -ENOMEM;
+
+	dsi->dev = dev;
+	dsi->lanes = 4;
+	platform_set_drvdata(pdev, dsi);
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -EINVAL;
+
+	dsi->base = devm_ioremap(dev, res->start, resource_size(res));
+	if (!dsi->base)
+		return -ENOMEM;
+
+	dsi->pclk = devm_clk_get_optional_enabled(dev, "pclk");
+	if (IS_ERR(dsi->pclk))
+		return PTR_ERR(dsi->pclk);
+
+	dsi->pdata.max_data_lanes = 4;
+	dsi->pdata.phy_ops = &ar_dsi_phy_ops;
+	dsi->pdata.priv_data = dsi;
+
+	dsi->dmd = dw_mipi_dsi_probe(pdev, &dsi->pdata);
+	if (IS_ERR(dsi->dmd))
+		return dev_err_probe(dev, PTR_ERR(dsi->dmd), "dw_mipi_dsi_probe failed\n");
+
+	return 0;
+}
+
+static void ar_dsi_remove(struct platform_device *pdev)
+{
+	struct ar_dsi *dsi = platform_get_drvdata(pdev);
+
+	dw_mipi_dsi_remove(dsi->dmd);
+}
+
+static const struct of_device_id ar_dsi_match[] = {
+	{ .compatible = "artosyn,gnd485-dsi" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, ar_dsi_match);
+
+static struct platform_driver ar_dsi_driver = {
+	.probe	= ar_dsi_probe,
+	.remove	= ar_dsi_remove,
+	.driver = {
+		.name		= "artosyn-dsi",
+		.of_match_table	= ar_dsi_match,
+	},
+};
+module_platform_driver(ar_dsi_driver);
+
+MODULE_DESCRIPTION("Artosyn MIPI-DSI host glue for dw-mipi-dsi");
+MODULE_LICENSE("GPL");
