#!/bin/sh
# Start kestrel-gnd at boot, once the baseband is ready, and keep it running.
#
# S60ar8030 backgrounds the bring-up, so "S60 has run" does not mean the
# baseband is ready: wait for /dev/arlinkN first. If it never comes, start
# kestrel-gnd anyway - when it cannot connect it restarts the baseband itself
# (S60ar8030 restart), which is the recovery a failed first bring-up needs.
#
# kestrel-gnd is supervised: if it dies for any reason, arlink.ko has already
# closed the radio sockets it left open, and starting it again is the whole
# recovery.

# The system clock runs in UTC (S36rtc converts the pcf8563's Beijing wall
# clock), so the OSD clock and the timestamps on recordings only come out local
# if TZ is exported here - kestrel-gnd inherits this environment. There is no
# tzdata on this rootfs, so TZ has to be a POSIX rules string, not a zone name.
[ -r /etc/kestrel/time.conf ] && . /etc/kestrel/time.conf
[ -n "$TZ" ] && export TZ

BIN=/usr/bin/kestrel-gnd
LOG=/var/log/kestrel-gnd.log        # this run; .prev the one before, .first
                                    # the first one since boot that ended
RADIO_WAIT=120      # max seconds to wait for /dev/arlinkN
SUPERVISOR=/var/run/kestrel-supervise.pid
CHIPLOG=/var/log/ar8030-chip.log    # the AR8030's own log, 2 x 1 MB at most

radio_up() { ls /dev/arlink[0-9]* >/dev/null 2>&1; }

# The pid in $SUPERVISOR, if that process is still this script (starting or
# supervising). A stale file can name a pid that has been reused since.
supervisor_pid() {
    p=$(cat $SUPERVISOR 2>/dev/null)
    [ -n "$p" ] && [ -r /proc/$p/cmdline ] &&
        tr '\0' ' ' < /proc/$p/cmdline | grep -q S70kestrel && echo $p
}

# kestrel-gnd brings the link back by itself (restarting the baseband when it
# cannot), so this only has to keep the process running. One that keeps dying
# straight after starting is restarted every 10 s instead of every second.
supervise() {
    echo $$ > $SUPERVISOR
    n=0
    quick=0
    while :; do
        n=$((n + 1))
        [ -f $LOG ] && mv -f $LOG $LOG.prev
        echo "kestrel: start $n (supervised)" > $LOG
        t0=$(cut -d. -f1 /proc/uptime)
        ARLINK_CHIPLOG=$CHIPLOG $BIN >> $LOG 2>&1
        rc=$?
        up=$(($(cut -d. -f1 /proc/uptime) - t0))
        echo "kestrel: exited with status $rc after ${up}s - starting it again" >> $LOG
        # A crash loop rotates through .prev in seconds; keep how it began.
        [ -f $LOG.first ] || cp $LOG $LOG.first
        if [ $up -lt 10 ]; then quick=$((quick + 1)); else quick=0; fi
        if [ $quick -ge 3 ]; then sleep 10; else sleep 1; fi
    done
}

start() {
    [ -x "$BIN" ] || { echo "kestrel: $BIN missing"; exit 0; }
    if p=$(supervisor_pid); then
        echo "kestrel: already started (pid $p)"
        return 0
    fi
    (
        i=0
        while [ $i -lt $RADIO_WAIT ] && ! radio_up; do
            sleep 2; i=$((i + 2))
        done
        radio_up || echo "kestrel: no /dev/arlinkN after ${RADIO_WAIT}s - starting" \
            "kestrel-gnd anyway, it restarts the baseband itself" >> $LOG

        # Only one process can hold the DRM master, and the splash (S12splash)
        # still has it. SIGUSR1 tells it to drop master and hold its current
        # frame rather than exit outright - exiting would free its
        # framebuffers immediately, which used to blank the screen for
        # however long kestrel-gnd's own setup took. kestrel-gnd sends the
        # splash the SIGTERM that actually ends it, itself, right after its
        # own first successful modeset (drm/drm.c's notify_splash_done()) -
        # so the on-screen hand-off is one atomic swap with nothing shown in
        # between, not splash-exits-then-black-then-kestrel-gnd-appears.
        [ -f /var/run/kestrel-splash.pid ] && \
            kill -USR1 "$(cat /var/run/kestrel-splash.pid)" 2>/dev/null

        # Same process from here on (exec keeps the pid), so $SUPERVISOR,
        # written below as soon as this starts, names it throughout.
        exec "$0" supervise
    ) &
    echo $! > $SUPERVISOR
}

stop() {
    # The supervisor first, or it starts kestrel-gnd again.
    p=$(supervisor_pid) && kill $p 2>/dev/null
    rm -f $SUPERVISOR
    if pidof kestrel-gnd >/dev/null 2>&1; then
        kill -INT $(pidof kestrel-gnd) 2>/dev/null
        i=0
        while pidof kestrel-gnd >/dev/null 2>&1 && [ $i -lt 12 ]; do
            usleep 500000; i=$((i + 1))
        done
        pidof kestrel-gnd >/dev/null 2>&1 && kill -9 $(pidof kestrel-gnd) 2>/dev/null
    fi
}

case "$1" in
    start|"") start ;;
    stop)     stop ;;
    restart)  stop; sleep 2; start ;;
    supervise) supervise ;;
    status)
        p=$(supervisor_pid) && echo "supervised (pid $p)"
        if pidof kestrel-gnd >/dev/null 2>&1; then
            echo "kestrel-gnd running (pid $(pidof kestrel-gnd))"
        else
            echo "kestrel-gnd not running"; exit 1
        fi ;;
    *) echo "usage: $0 {start|stop|restart|status|supervise}"; exit 1 ;;
esac
exit 0
