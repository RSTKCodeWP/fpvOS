// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * Minimal Ascent Gnd485 RAM-boot device tree.
 * Register/IRQ geometry follows the board's vendor DT and UART observations.
 * CPU startup uses the stock Gnd485 PSCI firmware interface. UART clock
 * binding follows Missing-Lynk/ml-kernel e3885c6394a7025eacd3a23f473276d9823beb25.
 */
/dts-v1/;
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/clock/artosyn,ar9311-mmc.h>

/ {
	model = "Caddx Ascent Gnd485 (AR9311)";
	compatible = "caddx,ascent-gnd485", "artosyn,proxima-9311";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&gic>;

	aliases {
		serial0 = &uart0;
		i2c1 = &i2c1;
	};

	chosen {
		stdout-path = "serial0:1152000n8";
		bootargs = "console=ttyS0,1152000 earlycon loglevel=7 mem=256M rdinit=/init";
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0 0>;
			enable-method = "psci";
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0 1>;
			enable-method = "psci";
		};
	};

	/* Use the same lower 256 MiB as stock Linux on this 512 MiB board.
	 * The upper half is dedicated codec DMA memory, outside normal Linux RAM.
	 */
	memory@20000000 {
		device_type = "memory";
		reg = <0 0x20000000 0 0x10000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* Preserve the secure-firmware range declared by the stock DT. */
		atf@23400000 {
			reg = <0 0x23400000 0 0x00c00000>;
			no-map;
		};

		/* Outside kernel/DT/initrd USB transfer destinations and the
		 * codec pool. Retained across warm resets, not power loss.
		 */
		ramoops@2ff00000 {
			compatible = "ramoops";
			reg = <0 0x2ff00000 0 0x00100000>;
			record-size = <0x20000>;
			console-size = <0x40000>;
			pmsg-size = <0x20000>;
			no-map;
		};

		/* Stock Gnd485 media MMZ: upper 256 MiB of physical DRAM,
		 * outside mem=256M Linux RAM. Only the codec owns this pool.
		 */
		codec_memory: codec-memory@30000000 {
			compatible = "shared-dma-pool";
			reg = <0 0x30000000 0 0x10000000>;
			no-map;
		};
	};

	hdmi_connector {
		compatible = "hdmi-connector";
		type = "a";
		port {
			hdmi_in: endpoint {
				remote-endpoint = <&bridge_out>;
			};
		};
	};

	/* Board supplies are already powered; no software rail switching. */
	bridge_vdd: regulator-bridge-vdd {
		compatible = "regulator-fixed";
		regulator-name = "bridge-vdd-always-on";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};
	bridge_vcc: regulator-bridge-vcc {
		compatible = "regulator-fixed";
		regulator-name = "bridge-vcc-always-on";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
		clock-frequency = <24000000>;
		always-on;
	};

	clk150m: clock-150m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <150000000>;
	};

	clk24m: clock-24m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	/* Gnd485 bank1 line13 (global GPIO36), high selects 3.3 V.
	 * Describe only 3.3 V until voltage switching and tuning are ported.
	 */
	sd_vmmc: regulator-sd-vmmc {
		compatible = "regulator-fixed";
		regulator-name = "sd-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio 14 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	sd_vqmmc: regulator-sd-vqmmc {
		compatible = "regulator-gpio";
		regulator-name = "sd-vqmmc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		gpios = <&gpio 36 GPIO_ACTIVE_HIGH>;
		gpios-states = <1>;
		states = <3300000 1>;
	};

	radio_power: regulator-radio-power {
		compatible = "regulator-fixed";
		regulator-name = "radio-power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio 41 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
		startup-delay-us = <100000>;
	};

	/* Gnd485 run.sh enables RF power on GPIO41 before sdio_cfg.sh.
	 * GPIO12 enables the radio's 3.3 V I/O,
	 * GPIO3 is its active-low reset (different from the VR04 goggle).
	 */
	radio_vmmc: regulator-radio-vmmc {
		compatible = "regulator-fixed";
		regulator-name = "radio-3v3";
		vin-supply = <&radio_power>;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio 12 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
		startup-delay-us = <100000>;
	};

	radio_vqmmc: regulator-radio-vqmmc {
		compatible = "regulator-gpio";
		regulator-name = "radio-vqmmc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&gpio 35 GPIO_ACTIVE_HIGH>;
		gpios-states = <1>;
		states = <3300000 1>;
	};

	radio_pwrseq: radio-pwrseq {
		compatible = "artosyn,ar8030-pwrseq";
		reset-gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
	};

	gic: interrupt-controller@201000 {
		compatible = "arm,gic-400";
		#interrupt-cells = <3>;
		#address-cells = <0>;
		interrupt-controller;
		reg = <0 0x00201000 0 0x1000>,
		      <0 0x00202000 0 0x2000>,
		      <0 0x00204000 0 0x2000>,
		      <0 0x00206000 0 0x2000>;
		interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* Stock h26x reference SRAM; stops before the GIC at 0x201000. */
		codec_sram: sram@1f0000 {
			compatible = "mmio-sram";
			reg = <0 0x001f0000 0 0x10000>;
		};

		video-codec@a080000 {
			compatible = "artosyn,ar9311-wave521c";
			reg = <0 0x0a080000 0 0x10000>,
			      <0 0x0a106000 0 0x210>,
			      <0 0x0a102000 0 0x20>,
			      <0 0x0a104018 0 4>;
			reg-names = "vpu", "media-crg", "isolation", "codec-clock";
			interrupts = <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>;
			sram = <&codec_sram>;
			memory-region = <&codec_memory>;
		};

		/* Stock display/control buses. Pinmux and gates currently rely on
		 * early firmware.
		 */
		i2c1: i2c@1202000 {
			compatible = "snps,designware-i2c";
			reg = <0 0x01202000 0 0x2000>;
			interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk150m>;
			clock-frequency = <400000>;
			i2c-sda-hold-time-ns = <300>;
			i2c-sda-falling-time-ns = <300>;
			i2c-scl-falling-time-ns = <300>;
			#address-cells = <1>;
			#size-cells = <0>;
			bridge@3b {
				compatible = "artosyn,gnd485-lt9611", "lontium,lt9611";
				reg = <0x3b>;
				reset-gpios = <&gpio 107 GPIO_ACTIVE_HIGH>;
				vdd-supply = <&bridge_vdd>;
				vcc-supply = <&bridge_vcc>;
				/* GPIO106 IRQ is not wired into Linux; poll connector status. */
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						bridge_in: endpoint {
							remote-endpoint = <&dsi_out>;
						};
					};
					port@2 {
						reg = <2>;
						bridge_out: endpoint {
							remote-endpoint = <&hdmi_in>;
						};
					};
				};
			};
		};

		vo: display@8810000 {
			compatible = "artosyn,gnd485-vo";
			reg = <0 0x08810000 0 0x10000>,
			      <0 0x0a10404c 0 4>,
			      <0 0x0a106018 0 4>;
			reg-names = "vo", "pixel-clock", "dc-crg";
			interrupts = <GIC_SPI 70 IRQ_TYPE_LEVEL_HIGH>;
			port {
				vo_out: endpoint {
					remote-endpoint = <&dsi_in>;
				};
			};
		};
		dsi: dsi@8850000 {
			compatible = "artosyn,gnd485-dsi";
			reg = <0 0x08850000 0 0x1000>;
			clocks = <&clk150m>;
			clock-names = "pclk";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					dsi_in: endpoint {
						remote-endpoint = <&vo_out>;
					};
				};
				port@1 {
					reg = <1>;
					dsi_out: endpoint {
						remote-endpoint = <&bridge_in>;
					};
				};
			};
		};

		/* Preserve the vendor boot chain and active rootfs. Only the three
		 * explicitly named update regions are writable. */
		qspi: spi@1e00000 {
			compatible = "artosyn,ar9301-qspi";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0 0x01e00000 0 0x1000>;
			reg-names = "qspi_base";
			clocks = <&clk150m>;
			flash@0 {
				compatible = "spi-nand";
				reg = <0>;
				spi-max-frequency = <150000000>;
				partitions {
					/* The parser maps these bank roles from validated GPT, not
					 * from a presumed stock-update parity. Never modifies GPT. */
					compatible = "fpvos,ar9311-partitions";
					#address-cells = <1>;
					#size-cells = <1>;
					partition@0 {
						label = "boot-protected";
						reg = <0x0 0xb40000>;
						read-only;
					};
					partition@b40000 {
						label = "kernel";
						reg = <0xb40000 0x600000>;
					};
					partition@1140000 {
						label = "dtb";
						reg = <0x1140000 0x60000>;
					};
					partition@11a0000 {
						label = "vendor-rootfs";
						reg = <0x11a0000 0x1500000>;
						read-only;
					};
					partition@26a0000 {
						label = "fpvos";
						reg = <0x26a0000 0x1500000>;
					};
					partition@3ba0000 {
						label = "vendor-data";
						reg = <0x3ba0000 0x4460000>;
						read-only;
					};
				};
			};
		};

		gpio: gpio@a10a000 {
			compatible = "caddx,gnd485-gpio", "artosyn,gpio";
			reg = <0 0x0a10a000 0 0x2000>;
			gpio-controller;
			#gpio-cells = <2>;

			/* Stock run.sh: keep the native USB connector in debug/device
			 * mode when the GPIO bank direction shadow becomes active.
			 */
			usb-device-hog {
				gpio-hog;
				gpios = <9 GPIO_ACTIVE_HIGH>;
				output-high;
				line-name = "usb-device-mode";
			};
			usb-debug-hog {
				gpio-hog;
				gpios = <10 GPIO_ACTIVE_HIGH>;
				output-low;
				line-name = "usb-debug-select";
			};
		};

		mmc_clocks: clock-controller@a104020 {
			compatible = "artosyn,ar9311-mmc-clock";
			reg = <0 0x0a104020 0 0x10>,
			      <0 0x0a108088 0 8>,
			      <0 0x0a1080c0 0 8>;
			#clock-cells = <1>;
			artosyn,clock-config = <0x87 2>, <0x80 0>;
		};

		/* Radio SDIO host; source clock and gates owned by CCF. */
		mmc@1b00000 {
			compatible = "artosyn,proxima-dw-mshc";
			reg = <0 0x01b00000 0 0x1000>;
			interrupts = <GIC_SPI 48 IRQ_TYPE_LEVEL_HIGH>;
			clock-frequency = <100000000>;
			clocks = <&clk150m>, <&mmc_clocks AR9311_CLK_SDMMC0>;
			clock-names = "biu", "ciu";
			max-frequency = <50000000>;
			bus-width = <4>;
			cap-sd-highspeed;
			cap-sdio-irq;
			broken-cd;
			no-mmc;
			no-sd;
			no-1-8-v;
			vmmc-supply = <&radio_vmmc>;
			vqmmc-supply = <&radio_vqmmc>;
			mmc-pwrseq = <&radio_pwrseq>;
		};

		/* Removable SD slot, from the Gnd485 vendor DT (not RF SDIO).
		 * Pinmux is still initialized by U-Boot; CCF owns the source clocks.
		 */
		mmc@1c00000 {
			compatible = "artosyn,proxima-dw-mshc";
			reg = <0 0x01c00000 0 0x1000>;
			interrupts = <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>;
			clock-frequency = <100000000>;
			clocks = <&clk150m>, <&mmc_clocks AR9311_CLK_SDMMC1>;
			clock-names = "biu", "ciu";
			max-frequency = <50000000>;
			card-detect-delay = <200>;
			vmmc-supply = <&sd_vmmc>;
			vqmmc-supply = <&sd_vqmmc>;
			bus-width = <4>;
			cap-sd-highspeed;
			disable-wp;
			no-1-8-v;
			no-mmc;
			no-sdio;
		};

		/* Register, IRQ and FIFO layout from the stock Gnd485 DT.
		 * Early firmware leaves the USB clock and PHY initialized.
		 */
		usb@8000000 {
			compatible = "artosyn,ar9311-usb", "snps,dwc2";
			reg = <0 0x08000000 0 0x40000>;
			interrupts = <GIC_SPI 74 IRQ_TYPE_LEVEL_HIGH>;
			dr_mode = "peripheral";
			g-np-tx-fifo-size = <0x20>;
			g-rx-fifo-size = <0x300>;
			g-tx-fifo-size = <0x300 0x200 0x200 0x20 0x10
					  0x10 0x10 0x10 0x10 0x10>;
		};

		uart0: serial@1500000 {
			compatible = "snps,dw-apb-uart";
			reg = <0 0x01500000 0 0x400>;
			interrupts = <GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk150m>;
			/* Keep earlycon's existing divisor; 8250_dw uses the clock
			 * and hardware fractional divisor for the normal console.
			 */
			reg-shift = <2>;
			reg-io-width = <4>;
		};

		watchdog@1600000 {
			compatible = "snps,dw-wdt";
			reg = <0 0x01600000 0 0x1000>;
			interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk24m>;
			snps,watchdog-tops = <0x00010000 0x00020000 0x00040000 0x00080000
				0x00100000 0x00200000 0x00400000 0x00800000
				0x01000000 0x02000000 0x04000000 0x08000000
				0x10000000 0x20000000 0x40000000 0x80000000>;
		};
	};
};
