# Vendor blobs — extracted from your own device firmware, never committed.
# No trailing slash: in a second worktree they are usually symlinks to the
# first one's, and a "dir/" pattern does not match a symlink.
/vendor/rootfs
/vendor/boot
/vendor/stock
/vendor/open8030
/vendor/ar9311-firmware

# Per-board Buildroot output (the checkout itself is a tracked submodule).
/output/
# Old build locations remain ignored; rebuild rather than moving their contents.
/buildroot/output/
/output-air/
/output-air-*/
/output-ar9311/
/output-ar9311-*/
/br-external/board/*/rootfs-overlay/**/output/

# Build artifacts
/sdcard.img
/sdcard.img.xz
*.o
*.so
build/
xbuild/
__pycache__/

# assembled SD images
/out/
